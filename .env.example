# DownPat Open Source - Environment Variables
# Copy this file to .env and fill in your values
# Required variables are marked with [REQUIRED]

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Node environment (development, production, test)
NODE_ENV=development

# Server port (API server)
# Default: 3001
PORT=3001

# ============================================
# FIREBASE CONFIGURATION
# ============================================

# [REQUIRED] Firebase Project ID
FIREBASE_PROJECT_ID=your-project-id

# Firebase Admin SDK Authentication
# Option 1: Service Account JSON file path (recommended for local development)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Option 2: Service Account JSON as base64 string (for Docker/CI)
# Generate with: cat service-account.json | base64
# FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii...

# Firebase Emulator (for local development/testing)
# Set to localhost:8080 to use Firestore emulator
# FIRESTORE_EMULATOR_HOST=localhost:8080

# ============================================
# AI PROVIDER API KEYS
# ============================================
# At least ONE AI provider is required for conversations
# Providers are automatically detected based on which keys are present

# [REQUIRED for moderation] OpenAI API Key
# Also used as AI provider if configured
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic API Key (optional)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API Key (optional)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=...

# ============================================
# AI PROVIDER MODEL CONFIGURATION
# ============================================
# Comma-separated list of models to enable for each provider
# Leave empty to use provider defaults

# OpenAI models (defaults: gpt-4o, gpt-4-turbo, gpt-3.5-turbo)
OPENAI_MODELS=gpt-4o,gpt-4-turbo,gpt-3.5-turbo

# Anthropic models (defaults: claude-3-5-sonnet-20241022, claude-3-haiku-20240307)
ANTHROPIC_MODELS=claude-3-5-sonnet-20241022,claude-3-haiku-20240307

# Gemini models (defaults: gemini-pro, gemini-1.5-pro)
GEMINI_MODELS=gemini-pro,gemini-1.5-pro

# ============================================
# CONTENT MODERATION
# ============================================

# Enable/disable content moderation globally
# When enabled, uses OpenAI Moderation API (requires OPENAI_API_KEY)
# Default: false
MODERATION_ENABLED=false

# ============================================
# DEVELOPMENT/TESTING
# ============================================

# Enable verbose logging
# DEBUG=downpat:*

# Vitest test timeout (ms)
# VITEST_TIMEOUT=10000
