    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "supertest": "^6.3.0",
    "@types/supertest": "^2.0.16",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/robhunter/oss-DownPat.git",
    "directory": "packages/express"
  },
  "bugs": {
    "url": "https://github.com/robhunter/oss-DownPat/issues"
  },
  "homepage": "https://github.com/robhunter/oss-DownPat/tree/main/packages/express#readme",
