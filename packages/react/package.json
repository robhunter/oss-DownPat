{
  "name": "@downpat/react",
  "version": "0.0.1",
  "description": "React integration for DownPat - API client, hooks, and route builder",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && npm run copy-css",
    "copy-css": "mkdir -p dist/routes/styles && cp src/routes/styles/*.css dist/routes/styles/",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@downpat/api-client": "^0.0.1",
    "@downpat/core": "^0.0.1",
    "@downpat/ui-components": "^0.0.1",
    "@downpat/admin-ui": "^0.0.1"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "jsdom": "^23.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/robhunter/oss-DownPat.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/robhunter/oss-DownPat/issues"
  },
  "homepage": "https://github.com/robhunter/oss-DownPat/tree/main/packages/react#readme",
  "keywords": [
    "downpat",
    "react",
    "hooks",
    "routing",
    "client"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Rob Hunter",
  "license": "MIT"
}
