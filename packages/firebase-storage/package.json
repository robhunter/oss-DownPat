    "directory": "packages/firebase-storage"
  },
  "bugs": {
    "url": "https://github.com/robhunter/oss-DownPat/issues"
  },
  "homepage": "https://github.com/robhunter/oss-DownPat/tree/main/packages/firebase-storage#readme",
  "keywords": [
    "downpat",
    "firebase",
    "firestore",
    "storage",
    "database"
