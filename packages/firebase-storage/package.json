{
  "name": "@downpat/firebase-storage",
  "version": "0.0.1",
  "description": "Firebase/Firestore storage implementation for DownPat",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
