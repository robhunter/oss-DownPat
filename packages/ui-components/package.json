{
  "name": "@downpat/ui-components",
  "version": "0.0.2",
  "description": "React UI components for DownPat conversations",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./dist/styles/default-theme.css",
    "./dist/styles/*.css": "./dist/styles/*.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && cp -r src/styles dist/",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@downpat/core": "^0.0.2",
    "markdown-to-jsx": "^9.6.1",
    "socket.io-client": "^4.7.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "jsdom": "^23.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/robhunter/oss-DownPat.git",
    "directory": "packages/ui-components"
  },
  "bugs": {
    "url": "https://github.com/robhunter/oss-DownPat/issues"
  },
  "homepage": "https://github.com/robhunter/oss-DownPat/tree/main/packages/ui-components#readme",
  "keywords": [
    "downpat",
    "react",
    "ui",
    "components",
    "chat",
    "conversation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Rob Hunter",
  "license": "MIT"
}
