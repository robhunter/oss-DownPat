{
  "name": "@downpat/admin-ui",
  "version": "0.0.1",
  "description": "React admin UI components for managing DownPat exercises",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./dist/styles/admin-ui.css",
    "./dist/styles/*.css": "./dist/styles/*.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && cp -r src/styles dist/",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@downpat/api-client": "^0.0.1",
    "@downpat/core": "^0.0.1"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "jsdom": "^23.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/robhunter/oss-DownPat.git",
    "directory": "packages/admin-ui"
  },
  "bugs": {
    "url": "https://github.com/robhunter/oss-DownPat/issues"
  },
  "homepage": "https://github.com/robhunter/oss-DownPat/tree/main/packages/admin-ui#readme",
  "keywords": [
    "downpat",
    "react",
    "admin",
    "ui",
    "dashboard",
    "exercises"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
