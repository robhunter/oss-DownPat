# Example app specific (if needed)
example-app/server/.env
example-app/client/.env

# Documentation build outputs (if using static site generator)
docs/dist/
docs/.cache/

# Don't ignore important config files
!.gitignore
!.nvmrc
!.prettierrc
!.prettierignore
!.eslintrc*
!tsconfig*.json
!jest.config.*
!tailwind.config.*
